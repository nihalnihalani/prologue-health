# Prologue — all optional. Absent = deterministic fixture path (demo still works).

# Medplum (app.medplum.com -> Project -> Clients)
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Stedi test mode (stedi.com/create-sandbox)
STEDI_API_KEY=
STEDI_PAYER_ID=60054

# Deepgram (console.deepgram.com) — server-side only; browser gets a short-lived token
DEEPGRAM_API_KEY=

# Gemini Live (aistudio.google.com/apikey) — server-side only.
# The browser receives a short-lived ephemeral token, never this key.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
