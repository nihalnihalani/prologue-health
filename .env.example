# Prologue configuration.
#
# Columns that matter: SERVER-ONLY means the value must never reach the browser
# (nothing here is NEXT_PUBLIC_). REQUIRED-IN tells you which environment fails
# to start without it.
#
# demo    = labeled fixture fallback permitted, visibly marked
# pilot   = real integrations required; failures surface instead of substituting

# ---------------------------------------------------------------------------
# Durable control plane. SERVER-ONLY. REQUIRED-IN: pilot (startup fails without it).
#
# Session workflow, transcripts, decisions, outbox, and audit. Holds PHI, so the
# provider needs an executed BAA before real patient data.
# Local: docker run -d --name prologue-pg -e POSTGRES_PASSWORD=prologue \
#          -e POSTGRES_USER=prologue -e POSTGRES_DB=prologue_test \
#          -p 55432:5432 postgres:16-alpine
# ---------------------------------------------------------------------------
DATABASE_URL=
# Set to "disable" only for a local container with no TLS. Never in production.
DATABASE_SSL=
DATABASE_POOL_MAX=10


# Medplum (app.medplum.com -> Project -> Clients)
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Stedi test mode (stedi.com/create-sandbox)
STEDI_API_KEY=
STEDI_PAYER_ID=60054

# Deepgram (console.deepgram.com) — server-side only; browser gets a short-lived token
DEEPGRAM_API_KEY=

# Gemini Live (aistudio.google.com/apikey) — server-side only.
# The browser receives a short-lived ephemeral token, never this key.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Runtime mode. "demo" (default) permits labeled fixture fallback.
# "pilot" requires real integrations and FAILS rather than substituting
# synthetic clinical or payer data.
PROLOGUE_MODE=demo
# Required in pilot mode: a browser alone must not be able to finalize.
PROLOGUE_CLINICIAN_SECRET=

# ---------------------------------------------------------------------------
# Governed LLM extraction. SERVER-ONLY. Falls back to no extraction if absent.
# Production PHI requires Vertex AI + a Google BAA — an AI Studio key is NOT
# BAA-covered, so this key is for demo/staging synthetic data only.
# ---------------------------------------------------------------------------
GEMINI_EXTRACT_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Moss retrieval (@inferedge/moss). SERVER-ONLY. Optional; absent = unavailable.
#
# BLOCKED FOR REAL PHI. Moss uploads document text to InferEdge for server-side
# index construction, its README forbids production use, and no BAA exists.
# lib/retrieval.ts refuses any document not marked synthetic, and refuses Moss
# entirely in pilot mode. Credentials from https://usemoss.dev
# ---------------------------------------------------------------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Tenant slug for the bootstrap clinic until Medplum-issued tenancy lands.
PROLOGUE_TENANT_SLUG=prologue-demo

# ---------------------------------------------------------------------------
# Actor session signing. SERVER-ONLY. REQUIRED-IN: pilot (startup fails without).
#
# HMAC key for signed actor tokens (>=32 chars). A weak or missing secret means
# anyone can mint clinician authority, which is the same as having no
# authorization at all. Generate: openssl rand -base64 48
# ---------------------------------------------------------------------------
PROLOGUE_SESSION_SECRET=
